{
  "name": "sauti-ya-mwananchi-video",
  "version": "1.0.0",
  "private": true,
  "description": "Motion graphic video for Sauti ya Mwananchi, built with Remotion",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render SautiPromo out/sauti-promo.mp4",
    "render:vertical": "remotion render SautiPromoVertical out/sauti-promo-vertical.mp4",
    "still": "remotion still SautiPromo out/thumbnail.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.526",
    "@remotion/fonts": "4.0.526",
    "@remotion/transitions": "4.0.526",
    "@remotion/zod-types": "4.0.526",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.526",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
